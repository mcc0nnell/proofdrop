# Default deliberately stays on Base Sepolia until a real-money launch.
NEXT_PUBLIC_CHAIN=base-sepolia

# Set after deploying the contracts.
NEXT_PUBLIC_PROOFDROP_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_DEPLOYMENT_BLOCK=

# Claim this at base.dev > Settings > Builder Codes.
NEXT_PUBLIC_BUILDER_CODE=

# Set after choosing a public deployment domain.
NEXT_PUBLIC_URL=http://localhost:3000

# Generated by the Base account-association flow after the public domain is live.
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=
